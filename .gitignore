# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.local

# Logs
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Project specific
autoresearch-results.tsv
coverage/
*.tmp
nul

# Generated coderef artifacts directory (all scanner/RAG/index output).
# Contents-glob + negation (NOT a bare `.coderef/` dir pattern): git cannot
# re-include a file beneath an excluded DIRECTORY, and rules.json is declared
# architecture (source-of-truth for the dependency-rules CI gate), not output.
.coderef/*
!.coderef/rules.json

# RAG incremental-index state file (written next to the indexed tree)
.coderef-rag-index.json

# Declaration-map build artifacts belong in dist/, never the source tree
*.d.ts.map
